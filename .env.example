GG_DB_HOST=localhost
GG_DB_NAME=geprek_geh
GG_DB_USER=root
GG_DB_PASS=
GG_DB_CHARSET=utf8mb4

# Password akun seed admin (opsional). Kosongkan = fallback 'AdminGeprek123'.
GEPREK_ADMIN_PASS=
# Nama & email akun admin (opsional).
GEPREK_ADMIN_NAME=
GEPREK_ADMIN_EMAIL=
# Password akun customer seed (opsional, hanya dipakai mode seed penuh).
GEPREK_CUSTOMER_PASS=

